{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pdf2md",
  "version": "1.0.0",
  "identifier": "com.vibing101.pdf2md",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pdf2md",
        "width": 1080,
        "height": 760,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Turn a document of PDF links into a tree of Markdown files",
    "longDescription": "Load a document that lists links to online PDFs, pick the ones you want, and pdf2md downloads each PDF and converts it to Markdown with Microsoft markitdown, filed into folders that mirror the document's own categories.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/pdf2md-service"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
